{
  "name": "claude-codex-review-bridge",
  "version": "0.3.2",
  "description": "A local, human-controlled bridge between Claude Code and a persistent Codex review session.",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "claude-code",
    "codex",
    "code-review",
    "ai-agents",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzi0espil/Codex-Claude-Reviewer-Bridge.git"
  },
  "bugs": {
    "url": "https://github.com/uzi0espil/Codex-Claude-Reviewer-Bridge/issues"
  },
  "homepage": "https://github.com/uzi0espil/Codex-Claude-Reviewer-Bridge#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js scripts/test/*.test.mjs && npm run test:package",
    "test:just": "node scripts/ci/just-smoke.mjs",
    "test:package": "node scripts/ci/package-smoke.mjs",
    "stage:package": "node scripts/ci/stage-npm-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "release": "npm run stage:package && semantic-release"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@playwright/mcp": "0.0.79",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
